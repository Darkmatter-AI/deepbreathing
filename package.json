    "check:email-contract": "node --test ./scripts/tests/email-reply-address.test.mjs",
    "check:email-dns": "CHECK_EMAIL_DNS=1 node --test ./scripts/tests/email-reply-address.test.mjs",
    "check:production-source": "node ./scripts/release/verify-production-source.mjs",
    "test": "node --test ./scripts/tests/*.test.mjs",
    "test:post-build": "node --test ./scripts/tests/homepage-ssr-deopt.test.mjs ./scripts/tests/languages-page-ssr.test.mjs"
