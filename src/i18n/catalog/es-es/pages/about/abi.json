:03.933Z","glossaryUpdatedAt":null,"isApproved":true,"method":"auto","needsReview":false,"pipelineVersion":null,"provider":"page_batch","qaChecks":null,"rulesUpdatedAt":null,"text":"Encontrar la investigación.","updatedAt":null}},{"attributeName":null,"catalogSegmentId":"9ae37256-8949-4a40-8b81-67cab1e24241","contextKey":"div","contextKeyVersion":"v1","elementSelector":"","fieldKey":null,"isUi":false,"manualOverride":{"isManuallyOverridden":false,"overriddenAt":null,"text":null,"translations":{}},"occurrenceKey":"sel:div:ctx:div:pos:3","pageSegmentId":"1f8e7f7d-9828-4508-900f-35b5ea41735c","position":26,"segmentType":"dom_body","sourceHash":"d1be6038a887fa2f8a963d52f248b0e9022f4483dbe10245de4a934af22684fd","sourceLocale":"en-gb","sourceText":"PubMed, DOI registries, Cochrane. Systematic reviews and RCTs beat single studies. Mechanism work, especially mouse studies, gets called out as such so it doesn't get mistaken for clinical evidence.","translation":{"appliedGlossaryTerms":null,"appliedRules":null,"catalogTranslationId":"0842be2c-7f10-4a72-b956-3343e836ddcc","createdAt":"2026-05-29T15:53:03.933Z","glossaryUpdatedAt":null,"isApproved":true,"method":"auto","needsReview":false,"pipelineVersion":null,"provider":"page_batch","qaChecks":null,"rulesUpdatedAt":null,"text":"PubMed, registros DOI, Cochrane. Las revisiones sistemáticas y los ECA superan a los estudios individuales. Los trabajos sobre mecanismos, especialmente los estudios en ratones, se señalan como tales para que no se confundan con evidencia clínica.","updatedAt":null}},{"attributeName":null,"catalogSegmentId":"2a75687c-4554-455b-b931-ab352113d514","contextKey":"product","contextKeyVersion":"v1","elementSelector":"","fieldKey":null,"isUi":false,"manualOverride":{"isManuallyOverridden":false,"overriddenAt":null,"text":null,"translations":{}},"occurrenceKey":"sel:strong.text-card-foreground:ctx:product:pos:3","pageSegmentId":"7fdeaac4-533c-4351-8b27-5fa46c2dd4c3","position":27,"segmentType":"dom_body","sourceHash":"8dc3d0f21996a4df1f250901b5ad4f8abd6dd78ce8fd4ac631b02981c573273c","sourceLocale":"en-gb","sourceText":"Verify everything.","translation":{"appliedGlossaryTerms":null,"appliedRules":null,"catalogTranslationId":"d197e310-ebab-41e4-8747-f6a172042a27","createdAt":"2026-05-29T15:53:03.933Z","glossaryUpdatedAt":null,"isApproved":true,"method":"auto","needsReview":false,"pipelineVersion":null,"provider":"page_batch","qaChecks":null,"rulesUpdatedAt":null,"text":"Verificar todo.","updatedAt":null}},{"attributeName":null,"catalogSegmentId":"42962402-d4da-4ad7-9506-49d6b86ffb38","contextKey":"div","contextKeyVersion":"v1","elementSelector":"","fieldKey":null,"isUi":false,"manualOverride":{"isManuallyOverridden":false,"overriddenAt":null,"text":null,"translations":{}},"occurrenceKey":"sel:div:ctx:div:pos:4","pageSegmentId":"a7743e99-aea0-48fc-be5b-5708cde8844b","position":28,"segmentType":"dom_body","sourceHash":"e01a1c5f224c6cd1d0f9b4bb8c3771dff8d959b0802b74a975f443a9c83dc6d7","sourceLocale":"en-gb","sourceText":"Every citation URL gets fetched and confirmed before it ships. Where a study is paywalled, the link goes to the free PubMed Central version.","translation":{"appliedGlossaryTerms":null,"appliedRules":null,"catalogTranslationId":"ca36d355-a74d-4e76-94e7-2723c9bb37a8","createdAt":"2026-05-29T15:53:03.933Z","glossaryUpdatedAt":null,"isApproved":true,"method":"auto","needsReview":false,"pipelineVersion":null,"provider":"page_batch","qaChecks":null,"rulesUpdatedAt":null,"text":"Cada URL de cita se obtiene y confirma antes de su publicación. Cuando un estudio está detrás de un muro de pago, el enlace dirige a la versión gratuita de PubMed Central.","updatedAt":null}},{"attributeName":null,"catalogSegmentId":"084554cb-160a-4dc6-8eea-e39b51010ba6","contextKey":"product","contextKeyVersion":"v1","elementSelector":"","fieldKey":null,"isUi":false,"manualOverride":{"isManuallyOverridden":false,"overriddenAt":null,"text":null,"translations":{}},"occurrenceKey":"sel:strong.text-card-foreground:ctx:product:pos:4","pageSegmentId":"b654a6c8-d497-4d69-879c-684ed1fb0eaa","position":29,"segmentType":"dom_body","sourceHash":"4b69b5673594155165c19762434bb5c601c4ff2521488f9806741e5871ff8142","sourceLocale":"en-gb","sourceText":"Match language to evidence.","translation":{"appliedGlossaryTerms":null,"appliedRules":null,"catalogTranslationId":"3c0ca89e-4b77-433b-9491-a90568b9f107","createdAt":"2026-05-29T15:53:03.933Z","glossaryUpdatedAt":null,"isApproved":true,"method":"auto","needsReview":false,"pipelineVersion":null,"provider":"page_batch","qaChecks":null,"rulesUpdatedAt":null,"text":"Ajustar el lenguaje a la evidencia.","updatedAt":null}},{"attributeName":null,"catalogSegmentId":"46f69909-e232-4e48-9695-a9665aecd53e","contextKey":"div","contextKeyVersion":"v1","elementSelector":"","fieldKey":null,"isUi":false,"manualOverride":{"isManuallyOverridden":false,"overriddenAt":null,"text":null,"translations":{}},"occurrenceKey":"sel:div:ctx:div:pos:5","pageSegmentId":"dfb22ec6-4c31-40b2-a301-15695415dbaf","position":30,"segmentType":"dom_body","sourceHash":"aab75f4a3834cbfa0c85cf78d9e21de5624c2deea135267a435d0b3a92040c89","sourceLocale":"en-gb","sourceText":"Strong evidence gets stated directly. Smaller studies get a “research suggests.” Weak, contested, or null findings get said out loud. The Wim Hof Method works no better than slow breathing for mood. Ujjayi's throat constriction doesn't actually outperform plain slow breathing on baroreflex.","translation":{"appliedGlossaryTerms":null,"appliedRules":null,"catalogTranslationId":"2e53300b-7195-49bd-90a7-336026ba052f","createdAt":"2026-05-29T15:53:03.933Z","glossaryUpdatedAt":null,"isApproved":true,"method":"auto","needsReview":false,"pipelineVersion":null,"provider":"page_batch","qaChecks":null,"rulesUpdatedAt":null,"text":"La evidencia sólida se expone directamente. Los estudios más pequeños se presentan con un «la investigación sugiere». Los hallazgos débiles, controvertidos o nulos se mencionan explícitamente. El Método Wim Hof no funciona mejor que la respiración lenta para el estado de ánimo. La constricción de garganta de Ujjayi no supera a la respiración lenta simple en el barorreflejo.","updatedAt":null}},{"attributeName":null,"catalogSegmentId":"dd56ec00-d6b5-4d04-be7f-1dc49b0b72e0","contextKey":"product","contextKeyVersion":"v1","elementSelector":"","fieldKey":null,"isUi":false,"manualOverride":{"isManuallyOverridden":false,"overriddenAt":null,"text":null,"translations":{}},"occurrenceKey":"sel:strong.text-card-foreground:ctx:product:pos:5","pageSegmentId":"5a21e841-0743-4f0a-aa44-bd9205e8cc6e","position":31,"segmentType":"dom_body","sourceHash":"e56d9ceec235cc2bd267c2d8b63e34043b249864603cef11f7e8515f5c7d27ca","sourceLocale":"en-gb","sourceText":"Place sources where you can use them.","translation":{"appliedGlossaryTerms":null,"appliedRules":null,"catalogTranslationId":"9c871252-5ced-4e39-8ff3-e9b41ae851fb","createdAt":"2026-05-29T15:53:03.933Z","glossaryUpdatedAt":null,"isApproved":true,"method":"auto","needsReview":false,"pipelineVersion":null,"provider":"page_batch","qaChecks":null,"rulesUpdatedAt":null,"text":"Colocar las fuentes donde puedan ser útiles.","updatedAt":null}},{"attributeName":null,"catalogSegmentId":"9086017e-12ff-46ef-83fe-b50d40d6f74c","contextKey":"div","contextKeyVersion":"v1","elementSelector":"","fieldKey":null,"isUi":false,"manualOverride":{"isManuallyOverridden":false,"overriddenAt":null,"text":null,"translations":{}},"occurrenceKey":"sel:div:ctx:div:pos:6","pageSegmentId":"48ad5136-2fda-4aec-acab-248ff328cb50","position":32,"segmentType":"dom_body","sourceHash":"ec23f98b08df38db5a04f267300e21af5d1e068929cafe1066b994df532f7f40","sourceLocale":"en-gb","sourceText":"One to three peer-reviewed links per page, hyperlinked on the specific claim. No numbered footnotes. No end-of-article reference lists. Click a phrase, land on the study.","translation":{"appliedGlossaryTerms":null,"appliedRules":null,"catalogTranslationId":"c