ourceLocale":"en-gb","sourceText":"The techniques people actually search for and practice. Box, 4-7-8, coherent breathing, the physiological sigh, Wim Hof, the pranayama variants, the COPD-rooted ones like pursed-lip and Buteyko. Plus the use cases they show up against: anxiety, sleep, focus, blood pressure.","translation":{"appliedGlossaryTerms":null,"appliedRules":null,"catalogTranslationId":"00bf9ccd-e7f1-4e85-95ee-67154cda54ed","createdAt":"2026-05-29T15:53:03.933Z","glossaryUpdatedAt":null,"isApproved":true,"method":"auto","needsReview":false,"pipelineVersion":null,"provider":"page_batch","qaChecks":null,"rulesUpdatedAt":null,"text":"Las técnicas que la gente realmente busca y practica. Box, 4-7-8, respiración coherente, el suspiro fisiológico, Wim Hof, las variantes de pranayama, las arraigadas en EPOC como la respiración con labios fruncidos y Buteyko. Además de los casos de uso para los que aparecen: ansiedad, sueño, concentración, tensión arterial.","updatedAt":null}},{"attributeName":null,"catalogSegmentId":"dd2906b6-7204-453a-b287-de55b7a97d00","contextKey":"product","contextKeyVersion":"v1","elementSelector":"","fieldKey":null,"isUi":false,"manualOverride":{"isManuallyOverridden":false,"overriddenAt":null,"text":null,"translations":{}},"occurrenceKey":"sel:strong.text-card-foreground:ctx:product:pos:1","pageSegmentId":"a3b18d0e-9ac2-48f5-8bde-fef7ebbeb4fd","position":21,"segmentType":"dom_body","sourceHash":"098efc7e3248ab1ac5a8c4737efe2b0956272f65d6d273889e0715ef37b94e65","sourceLocale":"en-gb","sourceText":"Source the lineage.","translation":{"appliedGlossaryTerms":null,"appliedRules":null,"catalogTranslationId":"a98109ad-3179-47ce-b178-dc10c7b2f0b6","createdAt":"2026-05-29T15:53:03.933Z","glossaryUpdatedAt":null,"isApproved":true,"method":"auto","needsReview":false,"pipelineVersion":null,"provider":"page_batch","qaChecks":null,"rulesUpdatedAt":null,"text":"Investigar el linaje.","updatedAt":null}},{"attributeName":null,"catalogSegmentId":"77a28294-419