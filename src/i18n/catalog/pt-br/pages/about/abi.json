ação lenta para o humor. A constrição da garganta de Ujjayi não supera a respiração lenta simples no barorreflexo.","updatedAt":null}},{"attributeName":null,"catalogSegmentId":"dd56ec00-d6b5-4d04-be7f-1dc49b0b72e0","contextKey":"product","contextKeyVersion":"v1","elementSelector":"","fieldKey":null,"isUi":false,"manualOverride":{"isManuallyOverridden":false,"overriddenAt":null,"text":null,"translations":{}},"occurrenceKey":"sel:strong.text-card-foreground:ctx:product:pos:5","pageSegmentId":"5a21e841-0743-4f0a-aa44-bd9205e8cc6e","position":31,"segmentType":"dom_body","sourceHash":"e56d9ceec235cc2bd267c2d8b63e34043b249864603cef11f7e8515f5c7d27ca","sourceLocale":"en-gb","sourceText":"Place sources where you can use them.","translation":{"appliedGlossaryTerms":null,"appliedRules":null,"catalogTranslationId":"01981439-8b03-497b-9598-894e4b03de0c","createdAt":"2026-05-29T15:53:32.378Z","glossaryUpdatedAt":null,"isApproved":true,"method":"auto","needsReview":false,"pipelineVersion":null,"provider":"page_batch","qaChecks":null,"rulesUpdatedAt":null,"text":"Posicione as fontes onde puder usá-las.","updatedAt":null}},{"attributeName":null,"catalogSegmentId":"9086017e-12ff-46ef-83fe-b50d40d6f74c","contextKey":"div","contextKeyVersion":"v1","elementSelector":"","fieldKey":null,"isUi":false,"manualOverride":{"isManuallyOverridden":false,"overriddenAt":null,"text":null,"translations":{}},"occurrenceKey":"sel:div:ctx:div:pos:6","pageSegmentId":"48ad5136-2fda-4aec-acab-248ff328cb50","position":32,"segmentType":"dom_body","sourceHash":"ec23f98b08df38db5a04f267300e21af5d1e068929cafe1066b994df532f7f40","sourceLocale":"en-gb","sourceText":"One to three peer-reviewed links per page, hyperlinked on the specific claim. No numbered footnotes. No end-of-article reference lists. Click a phrase, land on the study.","translation":{"appliedGlossaryTerms":null,"appliedRules":null,"catalogTranslationId":"be5c01ce-b228-4b41-a6ec-00261a48250f","createdAt":"2026-05-29T15:53:32.378Z","glossaryUpdated