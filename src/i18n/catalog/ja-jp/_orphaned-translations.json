d-722b9371ab68","contextKey":"head","isUi":false,"segmentType":"dom_head","sourceHash":"7a0758b9879366d02b53d0747f3e8dfd92a2b04ff01f10b1b21095fc2ddb5dd8","sourceLocale":"en-gb","sourceText":"9D Breathwork expliqué : Respiration, audio, coût (Pacer","translation":{"appliedGlossaryTerms":null,"appliedRules":null,"catalogTranslationId":"92a566fa-c05c-4699-8b0f-6aeca3ecfff7","createdAt":"2026-06-01T20:56:44.124Z","glossaryUpdatedAt":null,"isApproved":true,"method":"auto","needsReview":false,"pipelineVersion":null,"provider":"page_batch","qaChecks":null,"rulesUpdatedAt":null,"text":"9Dブレスワーク解説：呼吸法、オーディオ、費用 (Pacer","updatedAt":null}},{"catalogSegmentId":"2a7e118a-e54d-48a7-8507-9c665f158772","contextKey":"head:meta:property","isUi":false,"segmentType":"dom_head","sourceHash":"0833a176a0616cd4554ace88b8d8dfd1ba589826e38089a49922ded1306ce918","sourceLocale":"en-gb","sourceText":"Respiração 9D Explicada: A Respiração, o Áudio, o Custo","translation":{"appliedGlossaryTerms":null,"appliedRules":null,"catalogTranslationId":"ee62a4dd-7dbe-461e-8127-209838f24e48","createdAt":"2026-06-01T20:53:38.172Z","glossaryUpdatedAt":null,"isApproved":true,"method":"auto","needsReview":false,"pipelineVersion":null,"provider":"page_batch","qaChecks":null,"rulesUpdatedAt":null,"text":"9D呼吸法を解説：呼吸、オーディオ、費用について","updatedAt":null}},{"catalogSegmentId":"2d0e86fc-b1ae-45da-bc45-e38639997a5f","contextKey":"p","isUi":false,"segmentType":"dom_body","sourceHash":"6368855520af01f3e1ffffe40c3d144064870c89ba268fe769bb3143d3d79e6c","sourceLocale":"en-gb","sourceText":"Meta-analysis of 12 randomized controlled trials found breathwork practices produced significant reductions in stress, anxiety, and depressive symptoms compared to control conditions. Underlying conscious-connected breath protocols are studied; the 9D audio format specifically has no peer-reviewed studies.","translation":{"appliedGlossaryTerms":null,"appliedRules":null,"catalogTranslationId":"c7ac09f1-f2e0-477a-9d98-b6b89f9182ba","createdAt":"