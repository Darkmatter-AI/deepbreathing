Type":"dom_body","sourceHash":"9802ebe35b71598f9e0c83fd623a6fe923fb62dbf97980ced7582e55278bda6a","sourceLocale":"en-gb","sourceText":"Founder. Photographer. Built this site for the breathing techniques I use every day.","translation":{"appliedGlossaryTerms":null,"appliedRules":null,"catalogTranslationId":"b4026848-0d14-4ee7-8ec1-9152a25bf312","createdAt":"2026-05-29T15:55:08.893Z","glossaryUpdatedAt":null,"isApproved":true,"method":"auto","needsReview":false,"pipelineVersion":null,"provider":"page_batch","qaChecks":null,"rulesUpdatedAt":null,"text":"創設者。写真家。私が毎日実践する呼吸法のためにこのサイトを立ち上げました。","updatedAt":null}},{"attributeName":null,"catalogSegmentId":"9af68d59-d1bb-49fe-a966-d4e80b7daa1b","contextKey":"p","contextKeyVersion":"v1","elementSelector":"","fieldKey":null,"isUi":false,"manualOverride":{"isManuallyOverridden":false,"overriddenAt":null,"text":null,"translations":{}},"occurrenceKey":"sel:p:ctx:p:pos:0","pageSegmentId":"989b9513-30c2-4d8e-9ddc-1a7aafb215f4","position":10,"segmentType":"dom_body","sourceHash":"eed3f4ee9b34e515a0362f15f37711d6033640cad6e7646538d16faa9b6714d7","sourceLocale":"en-gb","sourceText":"I grew up in a family of meditation practitioners. It wasn't until later in life that I started being more intentional about breathwork. Once I did, I realized how useful these practices were on a day-to-day basis. They've been invaluable in furthering my photography work too.","translation":{"appliedGlossaryTerms":null,"appliedRules":null,"catalogTranslationId":"c7d255aa-bde9-4001-b465-5a7dc0f71051","createdAt":"2026-05-29T15:55:08.893Z","glossaryUpdatedAt":null,"isApproved":true,"method":"auto","needsReview":false,"pipelineVersion":null,"provider":"page_batch","qaChecks":null,"rulesUpdatedAt":null,"text":"私は瞑想を実践する家庭で育ちました。しかし、ブレスワークを意識的に行うようになったのは、人生の後半になってからです。実践してみると、これらの深呼吸の効果や深呼吸のやり方が日々の生活にどれほど役立つか実感しました。私の写真活動を深める上でも非常に貴重なものでした。","updatedAt":null}},{"attributeName":null,"catalogSegmentId":"c8c8b0d6-dfbb-4dec-868a-63745c0c8cac","contextKey":"p","cont