    "whyItWorks.items[0].description": {
      "catalogSourceText": "Long exhales activate your parasympathetic nervous system—the 'rest and digest' mode that counters stress.",
      "occurrenceKey": "sel:p.mt-2.text-sm:ctx:p:pos:0"
    },
    "whyItWorks.items[2].description": {
      "catalogSourceText": "Counting breath phases interrupts rumination and catastrophic thinking—you can't panic and count simultaneously.",
      "occurrenceKey": "sel:p.mt-2.text-sm:ctx:p:pos:2"
    },
    "comfortTips.items[0]": {
      "catalogSourceText": "Find a quiet spot when possible—even 30 seconds alone helps",
      "occurrenceKey": "sel:span:ctx:span:pos:0"
    },
    "comfortTips.items[1]": {
      "catalogSourceText": "Don't force deep breaths—smaller, smoother breaths work better",
      "occurrenceKey": "sel:span:ctx:span:pos:1"
    },
    "comfortTips.items[2]": {
      "catalogSourceText": "Start with just 1 minute—that's often enough",
      "occurrenceKey": "sel:span:ctx:span:pos:2"
    },
