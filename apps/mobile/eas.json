{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "image": "macos-tahoe-26.4-xcode-26.4"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "image": "macos-tahoe-26.4-xcode-26.4"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "amorim.a.ferreira@gmail.com",
        "ascAppId": "6786431781",
        "appleTeamId": "M29XZH5LMJ"
      }
    }
  }
}
